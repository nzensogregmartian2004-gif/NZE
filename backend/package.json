{
  "name": "@nze/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend NZE : API Express, PostgreSQL via Drizzle, intégration MyPVit",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/server.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"tests/*.test.ts\" \"src/modules/paiements/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/migrate.ts",
    "job:relances": "node --experimental-strip-types src/jobs/relances-quotidiennes.ts",
    "job:alertes-retards": "node --experimental-strip-types src/jobs/alertes-retards.ts",
    "job:rattrapage-paiements": "node --experimental-strip-types src/jobs/rattrapage-paiements.ts",
    "job:push-notifications": "node --experimental-strip-types src/jobs/push-notifications.ts",
    "verifier:secrets": "node scripts/verifier-secrets.mjs",
    "demarrage:local": "node --experimental-strip-types scripts/demarrage-local.ts",
    "verifier:prerequis": "node scripts/verifier-prerequis.mjs",
    "sandbox:mypvit": "node --experimental-strip-types scripts/sandbox-mypvit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.9.3"
  }
}
