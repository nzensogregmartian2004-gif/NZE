# Modèle de configuration backend. Copier vers .env (local) ou saisir dans le tableau de bord Render.
# Aucune valeur réelle ici. Ne jamais commiter .env.

APP_ENV=development            # development | test | production
PORT=3000
DATABASE_URL=                  # Supabase : utiliser la chaîne « Session pooler » (IPv4) et ajouter ?sslmode=require
SESSION_SECRET=                # 32 caractères minimum, aléatoire
OTP_PROVIDER=console           # console (test privé uniquement) | esms (production, à brancher)
ADMIN_BOOTSTRAP_PHONE=         # facultatif : voir la commande creer-admin

# --- Cartographie (Google Maps, décision 18) ---
# google = distance routière Google (production). estimation = ligne droite, développement seulement, refusé en production.
# Fournisseur des distances de livraison : mapbox (production) ou estimation (développement seulement)
CARTOGRAPHIE=mapbox
# Jeton SECRET Mapbox (commence par sk.) : serveur uniquement, jamais dans l’application mobile
MAPBOX_ACCESS_TOKEN=
# Clé serveur Google Maps (Distance Matrix). Jamais dans l'application mobile.
# GOOGLE_MAPS_API_KEY= (facultatif : seulement si CARTOGRAPHIE=google)

# --- MyPVit (PVit) : Airtel Money, Moov Money, Visa, Mastercard ---
# Les valeurs viennent de PVit. Le serveur génère la clé X-Secret à partir de ces valeurs : elle n'est jamais saisie à la main.
MYPVIT_BASE_URL=https://api.mypvit.pro
MYPVIT_OPERATION_ACCOUNT_CODE=
MYPVIT_PASSWORD=
MYPVIT_AGENT=
MYPVIT_PRODUCT=
MYPVIT_CALLBACK_URL_CODE=
MYPVIT_CODE_SECRET=
MYPVIT_CODE_PAYMENT=
MYPVIT_CODE_LINK=
MYPVIT_CODE_STATUS=
MYPVIT_CODE_FEES=
MYPVIT_CODE_COUNTRIES=
MYPVIT_CODE_OPERATORS=
MYPVIT_CODE_QRCODE=
MYPVIT_CODE_BALANCE=
MYPVIT_REDIRECT_SUCCESS_CODE=
MYPVIT_REDIRECT_FAILURE_CODE=
MYPVIT_TIMEOUT_MS=15000

# Mentions légales (obligatoires en production : le serveur refuse de démarrer sans elles)
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_CONTACT_EMAIL=

# --- Stockage des photos : Cloudflare R2 (décision D-T3). Toutes les variables R2_ obligatoires, ou aucune. ---
# Identifiant de compte (32 caractères). Non secret.
R2_ACCOUNT_ID=
# Nom du seau. Privé : les liens vers les photos sont signés et expirent.
R2_BUCKET=
# Jeton API R2 (Object Read & Write) : saisi dans Render, jamais dans le dépôt.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Facultatif : déduit de R2_ACCOUNT_ID si absent.
R2_ENDPOINT=

# --- Temps réel Supabase (décision D-RT-1). Les deux variables ensemble, ou aucune. ---
# URL du projet : non secrète (aussi utilisée par l'application mobile).
SUPABASE_URL=
# Clé de signature ES256 au format JWK, générée localement puis importée dans Supabase. SECRÈTE : Render uniquement.
SUPABASE_SIGNING_KEY=
